// https://aka.ms/devcontainer.json
{
    "name": "Laravel Package Skeleton (PHP 8.3)",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            "PHP_VERSION": "8.3"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "ms-azuretools.vscode-containers"
            ],
            "settings": {}
        }
    },
    "remoteUser": "vscode"
}